[Unit]
Description=Meshgram Telegram<->MeshCore bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=meshgram
Group=meshgram
WorkingDirectory=/opt/meshgram
# Every setting lives in this file (copy config.example.yaml; chmod 600).
Environment=MESHGRAM_CONFIG_PATH=/opt/meshgram/config.yaml
# Persistent state (packet_map history, plugin settings changed in the web app)
# lives in /var/lib/meshgram.
StateDirectory=meshgram
Environment=MESHGRAM_DATA_DIR=/var/lib/meshgram
ExecStart=/opt/meshgram/.venv/bin/python /opt/meshgram/main.py
Restart=on-failure
RestartSec=5

# Hardening (optional but recommended)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/meshgram

[Install]
WantedBy=multi-user.target
