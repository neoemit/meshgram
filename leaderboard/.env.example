# Copy to .env and fill in. (.env is gitignored.)

# Where Meshgram's web app is, as this machine reaches it (no trailing slash needed).
# Its check_in plugin must be running. https:// URLs are fine (and checked; see below).
MESHGRAM_URL=http://192.168.1.20:8080

# The check_in plugin's api_token (control panel: Plugins → Weekly check-ins → Settings).
# Make one with: openssl rand -hex 32
MESHGRAM_API_TOKEN=change-me

# Port this site listens on, on the host. Put a TLS reverse proxy (Caddy, Traefik,
# a Cloudflare tunnel, …) in front of it to publish it.
PORT=8090

# How often open pages ask for news, and how long the site shares one answer from
# Meshgram between visitors (Meshgram is asked at most once per this many seconds).
REFRESH_SECONDS=30
CACHE_SECONDS=15

# "off" accepts a self-signed certificate on an https:// MESHGRAM_URL.
MESHGRAM_TLS_VERIFY=on

# DNS server used to look up MESHGRAM_URL's host. Docker's own (the default) also
# resolves public names; set another (1.1.1.1, say) when running outside Docker networks.
RESOLVER=127.0.0.11
